PENSIEVE_POSTGRES_PASSWORD=replace-with-a-long-random-hex-value
PENSIEVE_DATABASE_URL=postgresql+asyncpg://pensieve:pensieve@localhost:5432/pensieve
PENSIEVE_REDIS_URL=redis://localhost:6379/0
PENSIEVE_SECRET_KEY=replace-with-a-long-random-string
PENSIEVE_BASE_URL=https://pensieve.example.com
PENSIEVE_SESSION_COOKIE_SECURE=true

# Optional local/OpenAI-compatible model gateway. Set PENSIEVE_AI_ENABLED=false
# if you only want the feed reader.
PENSIEVE_AI_ENABLED=true
PENSIEVE_LLM_BASE_URL=http://host.docker.internal:4000/v1
PENSIEVE_LLM_CATALOG_URL=http://host.docker.internal:4000/catalog.json
PENSIEVE_LLM_API_KEY=unused
PENSIEVE_LLM_FAST_MODEL=qwen3.8:27b-iq4_xs
PENSIEVE_LLM_LONG_MODEL=Qwen/Qwen3.8-Flash-Next
PENSIEVE_LLM_EMBEDDING_MODEL=nomic-embed-text
PENSIEVE_TIMEZONE=UTC

# Saved links and the page archive. Garage (the S3 store in docker-compose.yaml) is bootstrapped with these
# on every `compose up`; generate them once and keep them:
#   PENSIEVE_GARAGE_RPC_SECRET:  openssl rand -hex 32
#   PENSIEVE_GARAGE_ADMIN_TOKEN: openssl rand -hex 24
#   PENSIEVE_S3_ACCESS_KEY:      "GK" + openssl rand -hex 12   (Garage key ids are GK + 24 hex chars)
#   PENSIEVE_S3_SECRET_KEY:      openssl rand -hex 32
# Without S3 keys (e.g. running outside compose) saving still works but keeps only the article text.
PENSIEVE_GARAGE_RPC_SECRET=replace-with-64-hex-chars
PENSIEVE_GARAGE_ADMIN_TOKEN=replace-with-a-random-token
PENSIEVE_S3_ACCESS_KEY=GK000000000000000000000000
PENSIEVE_S3_SECRET_KEY=replace-with-64-hex-chars
# Optional: object store size the node advertises (GB), page-capture limits.
# PENSIEVE_GARAGE_CAPACITY_GB=200
# PENSIEVE_CAPTURE_CONCURRENCY=2
