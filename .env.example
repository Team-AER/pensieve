PENSIEVE_POSTGRES_PASSWORD=replace-with-a-long-random-hex-value
PENSIEVE_DATABASE_URL=postgresql+asyncpg://pensieve:pensieve@localhost:5432/pensieve
PENSIEVE_REDIS_URL=redis://localhost:6379/0
PENSIEVE_SECRET_KEY=replace-with-a-long-random-string
PENSIEVE_BASE_URL=https://pensieve.example.com
PENSIEVE_SESSION_COOKIE_SECURE=true

# Optional local/OpenAI-compatible model gateway. Set PENSIEVE_AI_ENABLED=false
# if you only want the feed reader.
PENSIEVE_AI_ENABLED=true
PENSIEVE_LLM_BASE_URL=http://host.docker.internal:4000/v1
PENSIEVE_LLM_CATALOG_URL=http://host.docker.internal:4000/catalog.json
PENSIEVE_LLM_API_KEY=unused
PENSIEVE_LLM_FAST_MODEL=qwen3.8:27b-iq4_xs
PENSIEVE_LLM_LONG_MODEL=Qwen/Qwen3.8-Flash-Next
PENSIEVE_LLM_EMBEDDING_MODEL=nomic-embed-text
PENSIEVE_TIMEZONE=UTC
